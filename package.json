{
  "name": "agm",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --config prisma.config.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate --config prisma.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma.config.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "clean:comments": "node scripts/remove-comments.mjs"
  },
  "dependencies": {
    "@next/swc-wasm-nodejs": "15.5.28",
    "@prisma/adapter-pg": "^6.13.0",
    "@prisma/client": "^6.13.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-outside-click-handler": "^1.3.4",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "framer-motion": "^13.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.31.0",
    "next": "^15.4.6",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.1.0",
    "react-outside-click-handler": "^1.3.0",
    "react-spinners": "^0.17.1",
    "react-to-print": "^3.3.0",
    "react-toastify": "^11.1.0",
    "server-only": "^0.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-react": "^5.32.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.32",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^18.0.7",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.4.6",
    "prettier": "^3.9.6",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^5.0.4"
  }
}
