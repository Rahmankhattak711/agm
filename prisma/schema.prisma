// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// 1. AUTHENTICATION & ACCESS CONTROL
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")

  journalEntries            JournalEntry[]
  approvedPettyCashVouchers PettyCashTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ============================================================================
// 2. CORE DOUBLE-ENTRY ACCOUNTING
// ============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model ChartOfAccount {
  id          String      @id @default(uuid()) @db.Uuid
  accountCode String      @unique @map("account_code")
  accountName String      @map("account_name")
  type        AccountType
  isActive    Boolean     @default(true) @map("is_active")

  parentId String?          @map("parent_id") @db.Uuid
  parent   ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("AccountHierarchy")

  journalLines                    JournalEntryLine[]
  fixedAssetAccounts              FixedAsset[]       @relation("AssetAccount")
  accumulatedDepreciationAccounts FixedAsset[]       @relation("AccumulatedDepreciationAccount")
  depreciationExpenseAccounts     FixedAsset[]       @relation("DepreciationExpenseAccount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chart_of_accounts")
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  entryNumber String   @unique @map("entry_number")
  entryDate   DateTime @map("entry_date") @db.Date
  description String?
  reference   String?
  isPosted    Boolean  @default(false) @map("is_posted")

  createdBy String @map("created_by") @db.Uuid
  user      User   @relation(fields: [createdBy], references: [id])

  lines                 JournalEntryLine[]
  depreciationSchedules DepreciationSchedule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("journal_entries")
}

model JournalEntryLine {
  id             String @id @default(uuid()) @db.Uuid
  journalEntryId String @map("journal_entry_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid

  debit  Decimal @default(0.00) @db.Decimal(15, 2)
  credit Decimal @default(0.00) @db.Decimal(15, 2)

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])

  vatEntry VatEntry?

  @@map("journal_entry_lines")
}

// ============================================================================
// 3. VAT TRACKING & POSITION
// ============================================================================

enum VatType {
  INPUT
  OUTPUT
}

model VatRate {
  id   String  @id @default(uuid()) @db.Uuid
  name String
  rate Decimal @db.Decimal(5, 2)

  vatEntries VatEntry[]

  @@map("vat_rates")
}

model VatEntry {
  id                 String  @id @default(uuid()) @db.Uuid
  journalEntryLineId String  @unique @map("journal_entry_line_id") @db.Uuid
  vatRateId          String? @map("vat_rate_id") @db.Uuid

  taxableAmount Decimal @map("taxable_amount") @db.Decimal(15, 2)
  vatAmount     Decimal @map("vat_amount") @db.Decimal(15, 2)
  vatType       VatType @map("vat_type")

  journalEntryLine JournalEntryLine @relation(fields: [journalEntryLineId], references: [id], onDelete: Cascade)
  vatRate          VatRate?         @relation(fields: [vatRateId], references: [id])

  @@map("vat_entries")
}

// ============================================================================
// 4. PETTY CASH MANAGEMENT
// ============================================================================

enum PettyCashType {
  TOP_UP
  DISBURSEMENT
}

model PettyCashTransaction {
  id              String        @id @default(uuid()) @db.Uuid
  transactionDate DateTime      @map("transaction_date") @db.Date
  voucherNumber   String        @unique @map("voucher_number")
  category        String
  amount          Decimal       @db.Decimal(12, 2)
  transactionType PettyCashType @map("transaction_type")
  receiptImageUrl String?       @map("receipt_image_url")

  approvedBy String? @map("approved_by") @db.Uuid
  approver   User?   @relation(fields: [approvedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("petty_cash_transactions")
}

// ============================================================================
// 5. FIXED ASSETS & DEPRECIATION SCHEDULE (20% Declining Balance Method)
// ============================================================================

model FixedAsset {
  id               String   @id @default(uuid()) @db.Uuid
  assetCode        String   @unique @map("asset_code")
  assetName        String   @map("asset_name")
  purchaseDate     DateTime @map("purchase_date") @db.Date
  cost             Decimal  @db.Decimal(15, 2)
  salvageValue     Decimal  @default(0.00) @map("salvage_value") @db.Decimal(15, 2)
  depreciationRate Decimal  @default(20.00) @map("depreciation_rate") @db.Decimal(5, 2)

  assetAccountId           String @map("asset_account_id") @db.Uuid
  accumulatedDeprAccountId String @map("accumulated_depr_account_id") @db.Uuid
  deprExpenseAccountId     String @map("depr_expense_account_id") @db.Uuid

  assetAccount           ChartOfAccount @relation("AssetAccount", fields: [assetAccountId], references: [id])
  accumulatedDeprAccount ChartOfAccount @relation("AccumulatedDepreciationAccount", fields: [accumulatedDeprAccountId], references: [id])
  deprExpenseAccount     ChartOfAccount @relation("DepreciationExpenseAccount", fields: [deprExpenseAccountId], references: [id])

  schedules DepreciationSchedule[]

  @@map("fixed_assets")
}

model DepreciationSchedule {
  id                 String  @id @default(uuid()) @db.Uuid
  assetId            String  @map("asset_id") @db.Uuid
  fiscalYear         Int     @map("fiscal_year")
  openingBookValue   Decimal @map("opening_book_value") @db.Decimal(15, 2)
  depreciationAmount Decimal @map("depreciation_amount") @db.Decimal(15, 2)
  closingBookValue   Decimal @map("closing_book_value") @db.Decimal(15, 2)
  isPosted           Boolean @default(false) @map("is_posted")

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("depreciation_schedules")
}

// ============================================================================
// 6. EMPLOYEE MASTER LIST
// ============================================================================

model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  employeeCode String   @unique @map("employee_code")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String?  @unique
  phone        String?
  department   String?
  designation  String?
  joiningDate  DateTime @map("joining_date") @db.Date
  basicSalary  Decimal  @map("basic_salary") @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("employees")
}
