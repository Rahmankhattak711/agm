generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  HR
  INVENTORY_MANAGER
  USER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")

  journalEntries JournalEntry[]
  expenses       Expense[]
  daybookEntries DaybookEntry[]

  markedAttendances DailyAttendance[] @relation("AttendanceMarker")
  approvedLeaves    LeaveRequest[]    @relation("LeaveApprover")
  approvedBonuses   Bonus[]           @relation("BonusApprover")

  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  quotations Quotation[]

  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  mustChangePassword  Boolean             @default(true) @map("must_change_password")
  lastLoginAt         DateTime?           @map("last_login_at")
  passwordChangedAt   DateTime?           @map("password_changed_at")
  failedLoginAttempts Int                 @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?           @map("locked_until")
  tokenVersion        Int                 @default(0) @map("token_version")
  deletedAt           DateTime?           @map("deleted_at")
  createdById         String?             @map("created_by_id") @db.Uuid
  createdBy           User?               @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers        User[]              @relation("UserCreator")
  auditLogs           AuditLog[]
  fiscalClosings      FiscalYearClosing[]

  tokens           RefreshToken[]
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]
  customerPayments CustomerPayment[]
  creditNotes      CreditNote[]
  purchaseRequests PurchaseRequest[]
  goodsReceipts    GoodsReceipt[]
  supplierBills    SupplierBill[]
  supplierPayments SupplierPayment[]
  debitNotes       DebitNote[]

  commercialAgreements CommercialAgreement[]
  riskAssessments      RiskAssessment[]
  methodStatements     MethodStatement[]
  salaryCertificates   SalaryCertificate[]
  customLetters        CustomLetter[]
  managedProjects      Project[]             @relation("ProjectManager")
  createdProjects      Project[]             @relation("ProjectCreator")
  recordedProjectCosts ProjectCost[]         @relation("CostRecorder")

  @@index([role, isActive])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model ChartOfAccount {
  id                  String      @id @default(uuid()) @db.Uuid
  accountCode         String      @unique @map("account_code")
  accountName         String      @map("account_name")
  nameAr              String?     @map("name_ar")
  type                AccountType
  accountSubtype      String?     @map("account_subtype")
  cashFlowType        String?     @default("Operating") @map("cash_flow_type")
  allowPosting        Boolean     @default(true) @map("allow_posting")
  enablePayments      Boolean     @default(false) @map("enable_payments")
  showInExpenseClaims Boolean     @default(false) @map("show_in_expense_claims")
  isSystem            Boolean     @default(false) @map("is_system")
  level               Int         @default(1)
  isActive            Boolean     @default(true) @map("is_active")

  parentId String?          @map("parent_id") @db.Uuid
  parent   ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("AccountHierarchy")

  journalLines                    JournalEntryLine[]
  fixedAssetAccounts              FixedAsset[]       @relation("AssetAccount")
  accumulatedDepreciationAccounts FixedAsset[]       @relation("AccumulatedDepreciationAccount")
  depreciationExpenseAccounts     FixedAsset[]       @relation("DepreciationExpenseAccount")
  expenseAccounts                 Expense[]          @relation("ExpenseAccount")
  paymentExpenseAccounts          Expense[]          @relation("PaymentAccount")
  inventoryAccounts               ProductCategory[]  @relation("InventoryAccount")
  cogsAccounts                    ProductCategory[]  @relation("CogsAccount")
  discountInvoices                SalesInvoice[]     @relation("InvoiceDiscountAccount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chart_of_accounts")
}

model AccountSubtype {
  id                  String      @id @default(uuid()) @db.Uuid
  name                String      @unique
  nameAr              String?     @map("name_ar")
  type                AccountType
  cashFlowType        String      @default("Operating") @map("cash_flow_type")
  description         String?
  parentCodePrefix    String?     @map("parent_code_prefix")
  enablePayments      Boolean     @default(false) @map("enable_payments")
  showInExpenseClaims Boolean     @default(false) @map("show_in_expense_claims")
  isSystem            Boolean     @default(false) @map("is_system")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  @@map("account_subtypes")
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  entryNumber String   @unique @map("entry_number")
  entryDate   DateTime @map("entry_date") @db.Date
  description String?
  reference   String?
  isPosted    Boolean  @default(false) @map("is_posted")

  createdBy String @map("created_by") @db.Uuid
  user      User   @relation(fields: [createdBy], references: [id])

  lines                 JournalEntryLine[]
  depreciationSchedules DepreciationSchedule[]
  daybookEntries        DaybookEntry[]

  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  salesInvoices    SalesInvoice[]
  customerPayments CustomerPayment[]
  creditNotes      CreditNote[]
  supplierBills    SupplierBill[]
  supplierPayments SupplierPayment[]
  debitNotes       DebitNote[]
  expenses         Expense[]

  @@index([isPosted, entryDate])
  @@index([entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(uuid()) @db.Uuid
  journalEntryId String  @map("journal_entry_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid

  description    String?
  debit          Decimal @default(0.00) @db.Decimal(15, 2)
  credit         Decimal @default(0.00) @db.Decimal(15, 2)

  currency       String  @default("AED")
  fxRate         Decimal @default(1.0000) @map("fx_rate") @db.Decimal(10, 4)
  debitAed       Decimal @default(0.00) @map("debit_aed") @db.Decimal(15, 2)
  creditAed      Decimal @default(0.00) @map("credit_aed") @db.Decimal(15, 2)

  taxRate        Decimal @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  taxType        String  @default("OUT_OF_SCOPE") @map("tax_type")
  taxAmount      Decimal @default(0.00) @map("tax_amount") @db.Decimal(15, 2)

  projectId      String?  @map("project_id") @db.Uuid
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  contactId      String?  @map("contact_id") @db.Uuid
  contactName    String?  @map("contact_name")

  branch         String?
  costCenter     String?  @map("cost_center")

  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        ChartOfAccount @relation(fields: [accountId], references: [id])

  vatEntry       VatEntry?

  @@index([journalEntryId])
  @@index([accountId])
  @@index([projectId])
  @@map("journal_entry_lines")
}

enum DaybookType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  EXPENSE
  GENERAL
}

model DaybookEntry {
  id            String      @id @default(uuid()) @db.Uuid
  voucherNumber String      @unique @map("voucher_number")
  entryDate     DateTime    @map("entry_date") @db.Date
  type          DaybookType
  partyName     String?     @map("party_name")
  description   String?
  amount        Decimal     @db.Decimal(15, 2)

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  isPosted Boolean   @default(false) @map("is_posted")
  postedAt DateTime? @map("posted_at")

  createdBy String @map("created_by") @db.Uuid
  user      User   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("daybook_entries")
}

enum VatType {
  INPUT
  OUTPUT
}

model VatRate {
  id   String  @id @default(uuid()) @db.Uuid
  name String
  rate Decimal @db.Decimal(5, 2)

  vatEntries VatEntry[]

  @@map("vat_rates")
}

model VatEntry {
  id                 String  @id @default(uuid()) @db.Uuid
  journalEntryLineId String  @unique @map("journal_entry_line_id") @db.Uuid
  vatRateId          String? @map("vat_rate_id") @db.Uuid

  taxableAmount Decimal @map("taxable_amount") @db.Decimal(15, 2)
  vatAmount     Decimal @map("vat_amount") @db.Decimal(15, 2)
  vatType       VatType @map("vat_type")

  journalEntryLine JournalEntryLine @relation(fields: [journalEntryLineId], references: [id], onDelete: Cascade)
  vatRate          VatRate?         @relation(fields: [vatRateId], references: [id])

  @@map("vat_entries")
}

enum ExpensePaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CASH
  CHEQUE
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model Expense {
  id            String               @id @default(uuid()) @db.Uuid
  expenseNumber String               @unique @map("expense_number")
  expenseDate   DateTime             @map("expense_date") @db.Date
  category      String
  payee         String?
  description   String?
  amount        Decimal              @db.Decimal(15, 2)
  taxAmount     Decimal              @default(0.00) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount   Decimal              @map("total_amount") @db.Decimal(15, 2)
  paymentMethod ExpensePaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  reference     String?
  receiptUrl    String?              @map("receipt_url")
  status        ExpenseStatus        @default(PAID)

  expenseAccountId String?         @map("expense_account_id") @db.Uuid
  expenseAccount   ChartOfAccount? @relation("ExpenseAccount", fields: [expenseAccountId], references: [id])

  paymentAccountId String?         @map("payment_account_id") @db.Uuid
  paymentAccount   ChartOfAccount? @relation("PaymentAccount", fields: [paymentAccountId], references: [id])

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id])

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("expenses")
}

enum AssetCategory {
  COMPANY_VEHICLE
  MACHINERY_EQUIPMENT
  OFFICE_EQUIPMENT
  FURNITURE_FIXTURES
  COMPUTER_HARDWARE
  LEASEHOLD_IMPROVEMENT
}

model FixedAsset {
  id               String        @id @default(uuid()) @db.Uuid
  assetCode        String        @unique @map("asset_code")
  assetName        String        @map("asset_name")
  category         AssetCategory @default(OFFICE_EQUIPMENT)
  purchaseDate     DateTime      @map("purchase_date") @db.Date
  cost             Decimal       @db.Decimal(15, 2)
  salvageValue     Decimal       @default(0.00) @map("salvage_value") @db.Decimal(15, 2)
  depreciationRate Decimal       @default(20.00) @map("depreciation_rate") @db.Decimal(5, 2)

  registrationNumber String? @map("registration_number")
  chassisNumber      String? @map("chassis_number")
  plateNumber        String? @map("plate_number")
  assignedTo         String? @map("assigned_to")
  driverName         String? @map("driver_name")
  imageUrl           String? @map("image_url") @db.Text
  fileName           String? @map("file_name")
  fileType           String? @map("file_type")
  notes              String? @map("notes") @db.Text

  assetAccountId           String @map("asset_account_id") @db.Uuid
  accumulatedDeprAccountId String @map("accumulated_depr_account_id") @db.Uuid
  deprExpenseAccountId     String @map("depr_expense_account_id") @db.Uuid

  assetAccount           ChartOfAccount @relation("AssetAccount", fields: [assetAccountId], references: [id])
  accumulatedDeprAccount ChartOfAccount @relation("AccumulatedDepreciationAccount", fields: [accumulatedDeprAccountId], references: [id])
  deprExpenseAccount     ChartOfAccount @relation("DepreciationExpenseAccount", fields: [deprExpenseAccountId], references: [id])

  schedules DepreciationSchedule[]

  @@map("fixed_assets")
}

model DepreciationSchedule {
  id                 String  @id @default(uuid()) @db.Uuid
  assetId            String  @map("asset_id") @db.Uuid
  fiscalYear         Int     @map("fiscal_year")
  openingBookValue   Decimal @map("opening_book_value") @db.Decimal(15, 2)
  depreciationAmount Decimal @map("depreciation_amount") @db.Decimal(15, 2)
  closingBookValue   Decimal @map("closing_book_value") @db.Decimal(15, 2)
  isPosted           Boolean @default(false) @map("is_posted")

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("depreciation_schedules")
}

enum PaymentMethod {
  WPS_BANK_TRANSFER
  CASH
  CHEQUE
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
}

model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  employeeCode String   @unique @map("employee_code")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String?  @unique
  phone        String?
  department   String?
  designation  String?
  joiningDate  DateTime @map("joining_date") @db.Date
  isActive     Boolean  @default(true) @map("is_active")

  gender          Gender?
  dateOfBirth     DateTime?      @map("date_of_birth") @db.Date
  nationality     String?
  maritalStatus   MaritalStatus? @map("marital_status")
  address         String?
  profilePhotoUrl String?        @map("profile_photo_url")

  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")

  emiratesId       String?   @unique @map("emirates_id")
  emiratesIdExpiry DateTime? @map("emirates_id_expiry") @db.Date
  passportNo       String?   @map("passport_no")
  passportExpiry   DateTime? @map("passport_expiry") @db.Date
  laborCardNo      String?   @map("labor_card_no")
  laborCardExpiry  DateTime? @map("labor_card_expiry") @db.Date
  visaNumber       String?   @map("visa_number")
  visaExpiry       DateTime? @map("visa_expiry") @db.Date

  contractType     ContractType     @default(FULL_TIME) @map("contract_type")
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  probationEndDate DateTime?        @map("probation_end_date") @db.Date
  contractEndDate  DateTime?        @map("contract_end_date") @db.Date
  terminationDate  DateTime?        @map("termination_date") @db.Date
  reportsToId      String?          @map("reports_to_id") @db.Uuid
  reportsTo        Employee?        @relation("EmployeeHierarchy", fields: [reportsToId], references: [id])
  directReports    Employee[]       @relation("EmployeeHierarchy")

  basicSalary        Decimal @map("basic_salary") @db.Decimal(12, 2)
  housingAllowance   Decimal @default(0.00) @map("housing_allowance") @db.Decimal(12, 2)
  transportAllowance Decimal @default(0.00) @map("transport_allowance") @db.Decimal(12, 2)
  otherAllowances    Decimal @default(0.00) @map("other_allowances") @db.Decimal(12, 2)
  monthlySalary      Decimal @default(0.00) @map("monthly_salary") @db.Decimal(12, 2)

  annualLeaveBalance Decimal @default(30.00) @map("annual_leave_balance") @db.Decimal(5, 1)

  paymentMethod PaymentMethod @default(WPS_BANK_TRANSFER) @map("payment_method")
  bankName      String?       @map("bank_name")
  iban          String?       @map("iban")

  payrolls    PayrollRecord[]
  attendances DailyAttendance[]
  leaves      LeaveRequest[]
  bonuses          Bonus[]
  salaryStructures SalaryStructure[]
  salarySlips      SalarySlip[]
  documents        EmployeeDocument[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employees")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

model DailyAttendance {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate DateTime @map("attendance_date") @db.Date

  checkInTime  DateTime? @map("check_in_time")
  checkOutTime DateTime? @map("check_out_time")

  status        AttendanceStatus @default(PRESENT)
  workingHours  Decimal?         @map("working_hours") @db.Decimal(4, 2)
  overtimeHours Decimal          @default(0.00) @map("overtime_hours") @db.Decimal(4, 2)
  lateMinutes   Int              @default(0) @map("late_minutes")

  location String?
  notes    String?

  markedBy String? @map("marked_by") @db.Uuid
  marker   User?   @relation("AttendanceMarker", fields: [markedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, attendanceDate])
  @@map("daily_attendance")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  EMERGENCY
  MATERNITY
  PATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType @map("leave_type")
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  totalDays Decimal   @map("total_days") @db.Decimal(4, 1)
  reason    String?

  status     LeaveStatus @default(PENDING)
  approvedBy String?     @map("approved_by") @db.Uuid
  approver   User?       @relation("LeaveApprover", fields: [approvedBy], references: [id])
  approvedAt DateTime?   @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leave_requests")
}

enum BonusType {
  PERFORMANCE
  FESTIVAL
  PROJECT_COMPLETION
  ATTENDANCE
  REFERRAL
  OTHER
}

model Bonus {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type   BonusType @default(OTHER)
  amount Decimal   @db.Decimal(12, 2)
  month  Int?
  year   Int?
  reason String?

  isApproved Boolean @default(false) @map("is_approved")
  approvedBy String? @map("approved_by") @db.Uuid
  approver   User?   @relation("BonusApprover", fields: [approvedBy], references: [id])

  isPaid   Boolean   @default(false) @map("is_paid")
  paidDate DateTime? @map("paid_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  @@map("bonuses")
}

model PayrollRecord {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  month      Int
  year       Int

  basicSalary      Decimal   @map("basic_salary") @db.Decimal(12, 2)
  allowances       Decimal   @default(0.00) @db.Decimal(12, 2)
  overtimeAmount   Decimal   @default(0.00) @map("overtime_amount") @db.Decimal(12, 2)
  bonusAmount      Decimal   @default(0.00) @map("bonus_amount") @db.Decimal(12, 2)
  absenceDeduction Decimal   @default(0.00) @map("absence_deduction") @db.Decimal(12, 2)
  otherDeductions  Decimal   @default(0.00) @map("other_deductions") @db.Decimal(12, 2)
  deductions       Decimal   @default(0.00) @db.Decimal(12, 2)
  netSalary        Decimal   @map("net_salary") @db.Decimal(12, 2)
  daysPresent      Decimal?  @map("days_present") @db.Decimal(4, 1)
  daysAbsent       Decimal?  @map("days_absent") @db.Decimal(4, 1)
  isPaid           Boolean   @default(false) @map("is_paid")
  paymentDate      DateTime? @map("payment_date") @db.Date
  remarks          String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([employeeId, month, year])
  @@map("payroll_records")
}

model Department {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique
  name         String
  description  String?
  isActive     Boolean       @default(true) @map("is_active")
  designations Designation[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("departments")
}

model Designation {
  id            String      @id @default(uuid()) @db.Uuid
  code          String      @unique
  name          String
  description   String?
  departmentId  String?     @map("department_id") @db.Uuid
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isFieldWorker Boolean     @default(false) @map("is_field_worker")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("designations")
}

model SalaryStructure {
  id                 String   @id @default(uuid()) @db.Uuid
  employeeId         String   @map("employee_id") @db.Uuid
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveDate      DateTime @map("effective_date") @db.Date
  basicSalary        Decimal  @map("basic_salary") @db.Decimal(12, 2)
  housingAllowance   Decimal  @default(0.00) @map("housing_allowance") @db.Decimal(12, 2)
  transportAllowance Decimal  @default(0.00) @map("transport_allowance") @db.Decimal(12, 2)
  otherAllowances    Decimal  @default(0.00) @map("other_allowances") @db.Decimal(12, 2)
  grossSalary        Decimal  @map("gross_salary") @db.Decimal(12, 2)
  notes              String?
  isActive           Boolean  @default(true) @map("is_active")
