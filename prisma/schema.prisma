  date      String @default("")
  status    String @default("DRAFT")

  addressee         String  @default("To Whom It May Concern,")
  addresseeSubtitle String? @map("addressee_subtitle")
  subject           String  @default("") @db.Text
  salutation        String  @default("Dear Sir / Madam,")

  sections Json @default("[]")

  closingText String? @map("closing_text") @db.Text

  signatoryCompany      String  @default("AGM Fitout Technical Services LLC") @map("signatory_company")
  signatoryTitle        String  @default("Authorized Signatory,") @map("signatory_title")
  signatoryName         String  @default("Zeeshan Ahmad") @map("signatory_name")
  signatoryDesignation  String  @default("Authorized Signatory") @map("signatory_designation")
  showStampAndSignature Boolean @default(true) @map("show_stamp_and_signature")
  companyStampUrl       String? @map("company_stamp_url") @db.Text
