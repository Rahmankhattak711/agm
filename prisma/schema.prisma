model PurchaseRequest {
  id            String                @id @default(uuid()) @db.Uuid
  requestNumber String                @unique @map("request_number")
  requesterName String                @map("requester_name")
  department    String?
  requestDate   DateTime              @default(now()) @map("request_date") @db.Date
  requiredDate  DateTime?             @map("required_date") @db.Date
  reason        String?
  notes         String?
  status        PurchaseRequestStatus @default(DRAFT)

  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   User?     @relation(fields: [createdById], references: [id])
  approvedAt  DateTime? @map("approved_at")

  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String          @id @default(uuid()) @db.Uuid
  purchaseRequestId String          @map("purchase_request_id") @db.Uuid
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  productId         String?         @map("product_id") @db.Uuid
  product           Product?        @relation(fields: [productId], references: [id])
  description       String
  quantity          Decimal         @default(1.00) @db.Decimal(12, 2)
  unit              String          @default("PCS")
  estimatedCost     Decimal         @default(0.00) @map("estimated_cost") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("purchase_request_items")
}

enum GoodsReceiptStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model GoodsReceipt {
  id                 String             @id @default(uuid()) @db.Uuid
  grnNumber          String             @unique @map("grn_number")
  purchaseOrderId    String?            @map("purchase_order_id") @db.Uuid
  purchaseOrder      PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  supplierId         String?            @map("supplier_id") @db.Uuid
  supplier           Supplier?          @relation(fields: [supplierId], references: [id])
  warehouseId        String?            @map("warehouse_id") @db.Uuid
  warehouse          Warehouse?         @relation(fields: [warehouseId], references: [id])
  receiptDate        DateTime           @default(now()) @map("receipt_date") @db.Date
  deliveryNoteNumber String?            @map("delivery_note_number")
  status             GoodsReceiptStatus @default(COMPLETED)
  notes              String?

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  items         GoodsReceiptItem[]
  supplierBills SupplierBill[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String       @id @default(uuid()) @db.Uuid
  goodsReceiptId   String       @map("goods_receipt_id") @db.Uuid
  goodsReceipt     GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId        String       @map("product_id") @db.Uuid
  product          Product      @relation(fields: [productId], references: [id])
  quantityReceived Decimal      @map("quantity_received") @db.Decimal(12, 2)
  quantityAccepted Decimal      @default(0.00) @map("quantity_accepted") @db.Decimal(12, 2)
  quantityDamaged  Decimal      @default(0.00) @map("quantity_damaged") @db.Decimal(12, 2)
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("goods_receipt_items")
}

enum SupplierBillStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model SupplierBill {
  id               String             @id @default(uuid()) @db.Uuid
  billNumber       String             @unique @map("bill_number")
  supplierId       String?            @map("supplier_id") @db.Uuid
  supplier         Supplier?          @relation(fields: [supplierId], references: [id])
  supplierName     String             @default("") @map("supplier_name")
  supplierTrn      String?            @map("supplier_trn")
  purchaseOrderId  String?            @map("purchase_order_id") @db.Uuid
  purchaseOrder    PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptId   String?            @map("goods_receipt_id") @db.Uuid
  goodsReceipt     GoodsReceipt?      @relation(fields: [goodsReceiptId], references: [id])
  billDate         DateTime           @default(now()) @map("bill_date") @db.Date
  dueDate          DateTime?          @map("due_date") @db.Date
  status           SupplierBillStatus @default(DRAFT)
  subtotal         Decimal            @default(0.00) @db.Decimal(15, 2)
  discount         Decimal            @default(0.00) @db.Decimal(15, 2)
  vatRate          Decimal            @default(5.00) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount        Decimal            @default(0.00) @map("vat_amount") @db.Decimal(15, 2)
  totalAmount      Decimal            @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  paidAmount       Decimal            @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  remainingBalance Decimal            @default(0.00) @map("remaining_balance") @db.Decimal(15, 2)

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   User?     @relation(fields: [createdById], references: [id])
  postedAt    DateTime? @map("posted_at")

  items      SupplierBillItem[]
  payments   SupplierPayment[]
  debitNotes DebitNote[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("supplier_bills")
}

model SupplierBillItem {
  id             String       @id @default(uuid()) @db.Uuid
  supplierBillId String       @map("supplier_bill_id") @db.Uuid
  supplierBill   SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  productId      String?      @map("product_id") @db.Uuid
  product        Product?     @relation(fields: [productId], references: [id])
  description    String
  quantity       Decimal      @default(1.00) @db.Decimal(12, 2)
  unit           String       @default("PCS")
  unitCost       Decimal      @default(0.00) @map("unit_cost") @db.Decimal(15, 2)
  totalAmount    Decimal      @default(0.00) @map("total_amount") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("supplier_bill_items")
}

model SupplierPayment {
  id              String                  @id @default(uuid()) @db.Uuid
  paymentNumber   String                  @unique @map("payment_number")
  supplierId      String?                 @map("supplier_id") @db.Uuid
  supplier        Supplier?               @relation(fields: [supplierId], references: [id])
  supplierName    String                  @default("") @map("supplier_name")
  supplierBillId  String?                 @map("supplier_bill_id") @db.Uuid
  supplierBill    SupplierBill?           @relation(fields: [supplierBillId], references: [id])
  paymentDate     DateTime                @default(now()) @map("payment_date") @db.Date
  amount          Decimal                 @db.Decimal(15, 2)
  paymentMethod   CommercialPaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  referenceNumber String?                 @map("reference_number")
  notes           String?

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("supplier_payments")
}

enum DebitNoteStatus {
  DRAFT
  POSTED
  CANCELLED
}

model DebitNote {
  id              String          @id @default(uuid()) @db.Uuid
  debitNoteNumber String          @unique @map("debit_note_number")
  supplierId      String?         @map("supplier_id") @db.Uuid
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  supplierBillId  String?         @map("supplier_bill_id") @db.Uuid
  supplierBill    SupplierBill?   @relation(fields: [supplierBillId], references: [id])
  purchaseOrderId String?         @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  returnDate      DateTime        @default(now()) @map("return_date") @db.Date
  reason          String?
  subtotal        Decimal         @default(0.00) @db.Decimal(15, 2)
  vatAmount       Decimal         @default(0.00) @map("vat_amount") @db.Decimal(15, 2)
  totalAmount     Decimal         @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  status          DebitNoteStatus @default(DRAFT)

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  items DebitNoteItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("debit_notes")
}

model DebitNoteItem {
  id          String    @id @default(uuid()) @db.Uuid
  debitNoteId String    @map("debit_note_id") @db.Uuid
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal   @default(1.00) @db.Decimal(12, 2)
  unitCost    Decimal   @default(0.00) @map("unit_cost") @db.Decimal(15, 2)
  totalAmount Decimal   @default(0.00) @map("total_amount") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("debit_note_items")
}

