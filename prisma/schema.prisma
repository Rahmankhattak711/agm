generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. AUTHENTICATION & ACCESS CONTROL

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  USER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")

  journalEntries            JournalEntry[]
  approvedPettyCashVouchers PettyCashTransaction[]
  daybookEntries            DaybookEntry[]

  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  tokens    RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// 2. CORE DOUBLE-ENTRY ACCOUNTING & DAYBOOK

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model ChartOfAccount {
  id          String      @id @default(uuid()) @db.Uuid
  accountCode String      @unique @map("account_code")
  accountName String      @map("account_name")
  type        AccountType
  isActive    Boolean     @default(true) @map("is_active")

  parentId String?          @map("parent_id") @db.Uuid
  parent   ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("AccountHierarchy")

  journalLines                    JournalEntryLine[]
  fixedAssetAccounts              FixedAsset[]           @relation("AssetAccount")
  accumulatedDepreciationAccounts FixedAsset[]           @relation("AccumulatedDepreciationAccount")
  depreciationExpenseAccounts     FixedAsset[]           @relation("DepreciationExpenseAccount")
  pettyCashAccounts               PettyCashTransaction[] @relation("PettyCashAccount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chart_of_accounts")
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  entryNumber String   @unique @map("entry_number")
  entryDate   DateTime @map("entry_date") @db.Date
  description String?
  reference   String?
  isPosted    Boolean  @default(false) @map("is_posted")

  createdBy String @map("created_by") @db.Uuid
  user      User   @relation(fields: [createdBy], references: [id])

  lines                 JournalEntryLine[]
  depreciationSchedules DepreciationSchedule[]
  daybookEntries        DaybookEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("journal_entries")
}

model JournalEntryLine {
  id             String @id @default(uuid()) @db.Uuid
  journalEntryId String @map("journal_entry_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid

  debit  Decimal @default(0.00) @db.Decimal(15, 2)
  credit Decimal @default(0.00) @db.Decimal(15, 2)

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])

  vatEntry VatEntry?

  @@map("journal_entry_lines")
}

// DAYBOOK (Daily Transaction Log for Sales, Purchases, Receipts, and Payments)

enum DaybookType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  PETTY_CASH
  GENERAL
}

model DaybookEntry {
  id            String      @id @default(uuid()) @db.Uuid
  voucherNumber String      @unique @map("voucher_number")
  entryDate     DateTime    @map("entry_date") @db.Date
  type          DaybookType
  partyName     String?     @map("party_name")
  description   String?
  amount        Decimal     @db.Decimal(15, 2)

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  isPosted Boolean   @default(false) @map("is_posted")
  postedAt DateTime? @map("posted_at")

  createdBy String @map("created_by") @db.Uuid
  user      User   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("daybook_entries")
}

// 3. VAT TRACKING & POSITION

enum VatType {
  INPUT
  OUTPUT
}

model VatRate {
  id   String  @id @default(uuid()) @db.Uuid
  name String
  rate Decimal @db.Decimal(5, 2)

  vatEntries VatEntry[]

  @@map("vat_rates")
}

model VatEntry {
  id                 String  @id @default(uuid()) @db.Uuid
  journalEntryLineId String  @unique @map("journal_entry_line_id") @db.Uuid
  vatRateId          String? @map("vat_rate_id") @db.Uuid

  taxableAmount Decimal @map("taxable_amount") @db.Decimal(15, 2)
  vatAmount     Decimal @map("vat_amount") @db.Decimal(15, 2)
  vatType       VatType @map("vat_type")

  journalEntryLine JournalEntryLine @relation(fields: [journalEntryLineId], references: [id], onDelete: Cascade)
  vatRate          VatRate?         @relation(fields: [vatRateId], references: [id])

  @@map("vat_entries")
}

// 4. PETTY CASH MANAGEMENT (Bank, Local Gov / Municipality, Operational)

enum PettyCashType {
  TOP_UP
  DISBURSEMENT
}

enum PettyCashCategoryType {
  BANK_CHARGE
  LOCAL_GOVERNMENT
  OPERATIONAL_EXPENSE
}

model PettyCashTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  transactionDate DateTime              @map("transaction_date") @db.Date
  voucherNumber   String                @unique @map("voucher_number")
  categoryType    PettyCashCategoryType @default(OPERATIONAL_EXPENSE) @map("category_type")
  category        String
  amount          Decimal               @db.Decimal(12, 2)
  transactionType PettyCashType         @map("transaction_type")
  receiptImageUrl String?               @map("receipt_image_url")
  notes           String?

  accountId String?         @map("account_id") @db.Uuid
  account   ChartOfAccount? @relation("PettyCashAccount", fields: [accountId], references: [id])

  approvedBy String? @map("approved_by") @db.Uuid
  approver   User?   @relation(fields: [approvedBy], references: [id])

  isApproved Boolean   @default(false) @map("is_approved")
  approvedAt DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("petty_cash_transactions")
}

// 5. FIXED ASSETS & VEHICLES (Depreciation Schedule)

enum AssetCategory {
  COMPANY_VEHICLE
  MACHINERY_EQUIPMENT
  OFFICE_EQUIPMENT
  FURNITURE_FIXTURES
  COMPUTER_HARDWARE
  LEASEHOLD_IMPROVEMENT
}

model FixedAsset {
  id               String        @id @default(uuid()) @db.Uuid
  assetCode        String        @unique @map("asset_code")
  assetName        String        @map("asset_name")
  category         AssetCategory @default(OFFICE_EQUIPMENT)
  purchaseDate     DateTime      @map("purchase_date") @db.Date
  cost             Decimal       @db.Decimal(15, 2)
  salvageValue     Decimal       @default(0.00) @map("salvage_value") @db.Decimal(15, 2)
  depreciationRate Decimal       @default(20.00) @map("depreciation_rate") @db.Decimal(5, 2)

  registrationNumber String? @map("registration_number")
  chassisNumber      String? @map("chassis_number")
  plateNumber        String? @map("plate_number")
  assignedTo         String? @map("assigned_to")
  driverName         String? @map("driver_name")

  assetAccountId           String @map("asset_account_id") @db.Uuid
  accumulatedDeprAccountId String @map("accumulated_depr_account_id") @db.Uuid
  deprExpenseAccountId     String @map("depr_expense_account_id") @db.Uuid

  assetAccount           ChartOfAccount @relation("AssetAccount", fields: [assetAccountId], references: [id])
  accumulatedDeprAccount ChartOfAccount @relation("AccumulatedDepreciationAccount", fields: [accumulatedDeprAccountId], references: [id])
  deprExpenseAccount     ChartOfAccount @relation("DepreciationExpenseAccount", fields: [deprExpenseAccountId], references: [id])

  schedules DepreciationSchedule[]

  @@map("fixed_assets")
}

model DepreciationSchedule {
  id                 String  @id @default(uuid()) @db.Uuid
  assetId            String  @map("asset_id") @db.Uuid
  fiscalYear         Int     @map("fiscal_year")
  openingBookValue   Decimal @map("opening_book_value") @db.Decimal(15, 2)
  depreciationAmount Decimal @map("depreciation_amount") @db.Decimal(15, 2)
  closingBookValue   Decimal @map("closing_book_value") @db.Decimal(15, 2)
  isPosted           Boolean @default(false) @map("is_posted")

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("depreciation_schedules")
}

// 6. PROFESSIONAL EMPLOYEE & PAYROLL DETAILS

enum PaymentMethod {
  WPS_BANK_TRANSFER
  CASH
  CHEQUE
}

model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  employeeCode String   @unique @map("employee_code")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String?  @unique
  phone        String?
  department   String?
  designation  String?
  joiningDate  DateTime @map("joining_date") @db.Date
  isActive     Boolean  @default(true) @map("is_active")

  emiratesId  String? @unique @map("emirates_id")
  passportNo  String? @map("passport_no")
  laborCardNo String? @map("labor_card_no")

  basicSalary        Decimal @map("basic_salary") @db.Decimal(12, 2)
  housingAllowance   Decimal @default(0.00) @map("housing_allowance") @db.Decimal(12, 2)
  transportAllowance Decimal @default(0.00) @map("transport_allowance") @db.Decimal(12, 2)
  otherAllowances    Decimal @default(0.00) @map("other_allowances") @db.Decimal(12, 2)

  paymentMethod PaymentMethod @default(WPS_BANK_TRANSFER) @map("payment_method")
  bankName      String?       @map("bank_name")
  iban          String?       @map("iban")

  payrolls PayrollRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employees")
}

model PayrollRecord {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  month      Int
  year       Int

  basicSalary Decimal   @map("basic_salary") @db.Decimal(12, 2)
  allowances  Decimal   @default(0.00) @db.Decimal(12, 2)
  deductions  Decimal   @default(0.00) @db.Decimal(12, 2)
  netSalary   Decimal   @map("net_salary") @db.Decimal(12, 2)
  isPaid      Boolean   @default(false) @map("is_paid")
  paymentDate DateTime? @map("payment_date") @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([employeeId, month, year])
  @@map("payroll_records")
}

// 7. MONTHLY BALANCE SHEET SUMMARY

model MonthlyBalanceSheetSummary {
  id    String @id @default(uuid()) @db.Uuid
  year  Int
  month Int

  totalAssets      Decimal @map("total_assets") @db.Decimal(15, 2)
  totalLiabilities Decimal @map("total_liabilities") @db.Decimal(15, 2)
  totalEquity      Decimal @map("total_equity") @db.Decimal(15, 2)
  retainedEarnings Decimal @map("retained_earnings") @db.Decimal(15, 2)

  isFinalized Boolean  @default(false) @map("is_finalized")
  generatedAt DateTime @default(now()) @map("generated_at")

  @@unique([year, month])
  @@map("monthly_balance_sheet_summaries")
}
