  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("custom_letters")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectCostType {
  MATERIAL
  LABOR
  EQUIPMENT
  SUBCONTRACTOR
  PERMITS
  TRANSPORT
  OVERHEAD
  OTHER
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  projectCode String          @unique @map("project_code")
  name        String
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)

  location  String?
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  deadline  DateTime?

  contractValue Decimal @default(0.00) @map("contract_value") @db.Decimal(15, 2)
  budget        Decimal @default(0.00) @map("budget") @db.Decimal(15, 2)
  estimatedCost Decimal @default(0.00) @map("estimated_cost") @db.Decimal(15, 2)
  actualCost    Decimal @default(0.00) @map("actual_cost") @db.Decimal(15, 2)
  materialCost  Decimal @default(0.00) @map("material_cost") @db.Decimal(15, 2)
  laborCost     Decimal @default(0.00) @map("labor_cost") @db.Decimal(15, 2)
  otherExpenses Decimal @default(0.00) @map("other_expenses") @db.Decimal(15, 2)
  progressPct   Int     @default(0) @map("progress_pct")

  quotationId String?    @map("quotation_id") @db.Uuid
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  customerId String?   @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  managerId String? @map("manager_id") @db.Uuid
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  costs        ProjectCost[]
  milestones   ProjectMilestone[]
  journalLines JournalEntryLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectCost {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  costType    ProjectCostType @default(OTHER) @map("cost_type")
  category    String?
  description String
  quantity    Decimal?        @db.Decimal(12, 2)
  unitRate    Decimal?        @map("unit_rate") @db.Decimal(15, 2)
  amount      Decimal         @default(0.00) @db.Decimal(15, 2)
  date        DateTime        @default(now())
  reference   String?
  notes       String?

  recordedById String? @map("recorded_by_id") @db.Uuid
  recordedBy   User?   @relation("CostRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_costs")
}

model ProjectMilestone {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  order          Int             @default(1)
  status         MilestoneStatus @default(NOT_STARTED)
  progressPct    Int             @default(0) @map("progress_pct")
  dueDate        DateTime?       @map("due_date")
  completionDate DateTime?       @map("completion_date")
  billedAmount   Decimal?        @map("billed_amount") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_milestones")
}

model FiscalYearClosing {
  id         String    @id @default(uuid()) @db.Uuid
  year       Int       @unique
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  isClosed   Boolean   @default(false) @map("is_closed")
  closedAt   DateTime? @map("closed_at")
  closedById String?   @map("closed_by_id") @db.Uuid
  closedBy   User?     @relation(fields: [closedById], references: [id], onDelete: SetNull)

  netProfitLoss            Decimal @default(0.00) @map("net_profit_loss") @db.Decimal(15, 2)
  retainedEarningsTransfer Decimal @default(0.00) @map("retained_earnings_transfer") @db.Decimal(15, 2)
  closingJournalId         String? @map("closing_journal_id") @db.Uuid

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fiscal_year_closings")
}
